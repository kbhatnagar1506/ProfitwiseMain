# Copy to .env.local and fill in. Every integration is independently optional —
# the app degrades gracefully when one is left unconfigured.

# ─── Required ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/profitwise
REDIS_URL=redis://localhost:6379

# Public base URL. Used to build OAuth redirect URIs, so it must match what is
# registered with each provider.
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Bank movements ──────────────────────────────────────────────────────────
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# ─── Accounting ledgers ──────────────────────────────────────────────────────
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_SANDBOX=true

XERO_CLIENT_ID=
XERO_CLIENT_SECRET=

# ─── Payments and commerce ───────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# ─── LLM tier (reconciliation Stage 4) ───────────────────────────────────────
# Without a key the matcher falls back to strict deterministic thresholds
# rather than guessing.
OPENAI_API_KEY=
OPENAI_COMPANY_CONTEXT_MODEL=gpt-4o

# ─── Entity memory ───────────────────────────────────────────────────────────
SUPERMEMORY_API_KEY=

# ─── Messaging ───────────────────────────────────────────────────────────────
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# ─── Google Cloud (entity blob storage, Gmail sync) ──────────────────────────
GCP_SERVICE_KEY_JSON=
GCP_ENTITY_BUCKET=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# ─── Endpoint auth ───────────────────────────────────────────────────────────
# CRON_SECRET guards scheduled routes; CLEAN_DB_SECRET guards the destructive
# admin routes, which additionally refuse to run outside production.
CRON_SECRET=
CLEAN_DB_SECRET=

# ─── Feature flags ───────────────────────────────────────────────────────────
RECONCILIATION_ENTITY_FILTER=true
