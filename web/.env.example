# Copy to .env.local and fill in.
#
# Variable names here are taken from the code, not from convention — several are
# non-obvious (GMAIL_OAUTH_CLIENT_ID, not GMAIL_CLIENT_ID; TWILIO_WHATSAPP_FROM,
# not _NUMBER; Redis is host/port/password, not a URL).
#
# Every connector is independently optional. The app degrades rather than
# crashes when one is unconfigured, and the LLM tiers fall back to stricter
# deterministic thresholds rather than guessing when no key is present.

# ─── Database (choose ONE of the two) ────────────────────────────────────────
# 1. Direct connection string:
DATABASE_URL=postgresql://user:password@localhost:5432/profitwise

# 2. Or GCP Cloud SQL connector (takes precedence when all four are set):
# INSTANCE_CONNECTION_NAME=project:region:instance
# DB_USER=
# DB_PASS=
# DB_NAME=
# CLOUD_SQL_IP_TYPE=PUBLIC
# GOOGLE_APPLICATION_CREDENTIALS_JSON=

# ─── Redis (Bull queue) ──────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── App URL ─────────────────────────────────────────────────────────────────
# Used to build OAuth redirect URIs, so it must match what each provider has
# registered.
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Plaid — bank accounts and transactions ──────────────────────────────────
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# ─── QuickBooks — invoices, bills, contacts ──────────────────────────────────
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_SANDBOX=true
QUICKBOOKS_WEBHOOK_VERIFIER=

# ─── Xero — invoices, bills, contacts ────────────────────────────────────────
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_WEBHOOK_KEY=

# ─── Stripe — invoices, payouts, processor fees ──────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_CLIENT_ID=
STRIPE_WEBHOOK_SECRET=

# ─── Shopify — orders as movements ───────────────────────────────────────────
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_REDIRECT_URI=
SHOPIFY_API_VERSION=
SHOPIFY_REQUIRED_SCOPES=

# ─── Gmail — invoice and bill extraction from email ──────────────────────────
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_ADMIN_EMAIL=
GMAIL_INBOX_USER_ID=

# ─── Slack ───────────────────────────────────────────────────────────────────
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=

# ─── Twilio (WhatsApp) ───────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=

# ─── Supermemory — entity memory grounding for the LLM tier ──────────────────
SUPERMEMORY_API_KEY=
SUPERMEMORY_DEFAULT_FINANCE_TAG=
SUPERMEMORY_ON_EVERY_LLM=false

# ─── LLM (OpenAI-compatible) ─────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_COMPANY_CONTEXT_MODEL=gpt-4o
# Optional override for a different OpenAI-compatible endpoint:
FORECAST_LLM_API_URL=https://api.openai.com/v1/chat/completions
FORECAST_LLM_API_KEY=
RECON_SCORING_MODEL=

# ─── Google Cloud Storage — entity blob store ────────────────────────────────
GCP_SERVICE_KEY_JSON=
GCP_ENTITY_BUCKET=

# ─── reCAPTCHA — signup protection ───────────────────────────────────────────
RECAPTCHA_SECRET_KEY=

# ─── Endpoint auth ───────────────────────────────────────────────────────────
# CRON_SECRET guards scheduled routes (bearer token).
# CLEAN_DB_SECRET guards admin routes via the x-clean-db-secret header; those
# routes additionally refuse to run unless NODE_ENV=production.
CRON_SECRET=
CLEAN_DB_SECRET=

# ─── Feature flags ───────────────────────────────────────────────────────────
RECONCILIATION_ENTITY_FILTER=true
RECONCILIATION_ENGINE=
ENABLE_LLM_STAGE4=
AR_LLM_ENABLED=
AP_LLM_ENABLED=
FORECAST_LLM_ENABLED=
FORECAST_USE_CASH_EVENTS=
TWO_PHASE_LLM=
CLASSIFICATION_PRECEDENCE=
MOVEMENT_LLM_HISTORY_N=
IDENTITY_GATE_LLM=
IDENTITY_GATE_MIN_SCORE=
IDENTITY_GATE_MIN_ENTITY_CONF=
